.DS_Store
.env
.env.*
!.env.example
.sui-client/
.superpowers/
/docs/superpowers/
/skills-lock.json
__pycache__/

# Sui Move build artifacts in any package below sui/
sui/**/.move/
sui/**/build/
sui/**/.trace
sui/**/.coverage_map.mvcov
sui/**/traces/
sui/**/coverage/

# Scratch interface compilation artifacts.
scratch-sui/**/.move/
scratch-sui/**/build/
scratch-sui/**/.trace
scratch-sui/**/.coverage_map.mvcov
scratch-sui/**/traces/
scratch-sui/**/coverage/

# Rust programmable-transaction harness output; each run relinks the fixture lockfiles
sui/**/target/
sui/launchpad/ptb_tests/fixture/*/Move.lock

# Local reports; normalized public deployment records belong in deployments/
coverage/
lcov.info

# Claude Code per-user settings and scratch worktrees
.claude/settings.local.json
.claude/worktrees/
