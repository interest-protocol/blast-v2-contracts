  "findings": [
    {
      "id": "F-1",
      "severity": "low",
      "area": "sui/presale/sources/bluefin.move migrate",
      "detail": "Since ADR 0111 the venue reads venue_config::pool_tier<Meme>() before blast_presale::migrate checks the migration witness. Bluefin's migrate on a sale another migrator started (an external migrator's or the Aftermath vendor's) therefore aborts in sui::dynamic_field::borrow_child_object, not EWrongMigrationWitness. The sale is still refused; only the error is opaque. Observed in E2E-035 and E2E-040."
    },
    {
      "id": "F-2",
      "severity": "medium",
      "area": "sui/vendors/aftermath_dao_presale/scripts/publish_immutable.sh",
      "detail": "The interface stubs declare no dependencies, so sui client omits the Aftermath AMM and DAO-fee packages' own linkage and the publish fails with PublishUpgradeMissingDependency. Publication needs those six packages added (see the deployment record's aftermathTransitiveDependencies)."
    },
    {
      "id": "F-3",
      "severity": "info",
      "area": "sui/presale/sources/cetus.move:135",
      "detail": "sui move lint --warnings-are-errors fails on main (EL02013: discarded meme_is_coin_a result in cetus::new_vault), so scripts/verify.sh all fails. GitHub Actions did not run after contracts #80 (billing), so CI did not catch it."
    }
  ],
