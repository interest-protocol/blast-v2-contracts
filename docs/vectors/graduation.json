          {
            "channel_id": "30",
            "bps": 3000
          },
          {
            "channel_id": "10",
            "bps": 1000
          },
          {
            "channel_id": "0",
            "bps": 3000
          },
          {
            "channel_id": "20",
            "bps": 3000
          }
        ],
        "quote_weights": [
          {
