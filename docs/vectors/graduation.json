{
  "schema_version": 4,
  "description": "Canonical Blast V2 one-time Meme and terminal-Quote allocation tables, protected-first exact apportionment, and the amounts paid to each destination when migration completes.",
  "source_decisions": [
    "docs/decisions/0039-deterministic-quote-valuations.md",
    "docs/decisions/0088-reusable-launch-accounting-and-atomic-migration.md"
  ],
  "units": {
    "meme": "atomic units of the generated Meme currency",
    "quote": "atomic units of the selected Quote currency",
    "rate": "basis points, 10000 = 100%",
    "channel_id": "stable u64 identity; zero is reserved for the curve and is valid only in the Meme table",
    "rounding": {
      "protocol": "ceil - the configured protocol allocation is protected first when present",
      "other_entries": "floor before residual distribution",
      "residual": "one atomic unit per unprotected entry by descending fractional remainder, then ascending channel ID",
      "conservation": "each asset's apportioned amounts sum exactly to that asset's input total",
      "terminal_curve_meme": "ceil - the curve never releases more Meme than the exact rational endpoint",
      "valuations": "floor - reported implied total-supply value never exceeds the exact rational value"
    }
  },
  "parameters": {
    "basis_points_denominator": 10000,
    "maximum_migration_channels": 16,
    "maximum_protocol_meme_bps": 9998,
    "maximum_protocol_quote_bps": 9999
  },
  "policy": {
    "owner": "LaunchConfig",
    "mutability": "future-launches",
    "match": "Every finalized launch snapshots the configured protocol Meme and Quote BPS into its immutable allocation plan.",
    "zero_policy": "A zero/zero protocol policy is always present and charges no protocol migration fee."
  },
  "formulas": {
    "terminal_curve_meme": "ceil(curve_meme * virtual_quote / (virtual_quote + graduation_target))",
    "curve_meme_released": "curve_meme - terminal_curve_meme",
    "opening_valuation": "floor(total_meme * virtual_quote / curve_meme)",
    "curve_terminal_valuation": "floor(total_meme * (virtual_quote + graduation_target) / terminal_curve_meme)",
    "dex_opening_valuation": "floor(total_meme * terminal_quote / liquidity_meme)"
  },
  "payout_semantics": {
    "liquidity": "The sole liquidity channel's amounts enter the migration handoff to the launch's bound adapter.",
    "non_liquidity": "Each non-liquidity channel's nonzero amounts are pushed to its immutable destination inside the successful migration transaction.",
    "fees": "One-time allocations never enter the recurring LP-fee routes."
  },
  "cases": [
    {
      "name": "recommended_sui_lane",
      "kind": "allocation_apportionment",
      "given": {
        "total_meme": "1000000000000000000",
        "total_quote": "8000000000000",
        "virtual_quote": "8000000000000",
        "graduation_target": "8000000000000",
        "protocol_policy": {
          "channel_id": "30",
          "destination": "0x30",
          "meme_bps": 0,
          "quote_bps": 0
        },
        "channels": [
          {
            "channel_id": "20",
            "role": "Liquidity",
            "destination": "0x20"
          }
        ],
        "meme_weights": [
          {
            "channel_id": "0",
            "bps": 8000
          },
          {
            "channel_id": "20",
            "bps": 2000
          }
        ],
        "quote_weights": [
          {
            "channel_id": "20",
            "bps": 10000
          }
        ]
      },
      "expect": {
        "canonical_channel_ids": [
          "20"
        ],
        "meme_allocations": [
          {
            "channel_id": "0",
            "amount": "800000000000000000"
          },
          {
            "channel_id": "20",
            "amount": "200000000000000000"
          }
        ],
        "quote_allocations": [
          {
            "channel_id": "20",
            "amount": "8000000000000"
          }
        ],
        "protocol_paid_at_migration": {
          "meme": "0",
          "quote": "0"
        },
        "terminal_curve_meme": "400000000000000000",
        "curve_meme_released": "400000000000000000",
        "opening_valuation": "10000000000000",
        "curve_terminal_valuation": "40000000000000",
        "dex_opening_valuation": "40000000000000"
      },
      "notes": "This preserves the illustrative 80/20 Meme and 100% liquidity-Quote lane without fixed protocol-fee or liquidity-provision fields."
    },
    {
      "name": "protected_first_and_remainder_order",
      "kind": "allocation_apportionment",
      "given": {
