            "channel_id": "0",
            "amount": "3001"
          },
          {
            "channel_id": "10",
            "amount": "1001"
          },
          {
            "channel_id": "20",
            "amount": "3001"
          },
          {
            "channel_id": "30",
            "amount": "3000"
          }
        ],
        "quote_allocations": [
          {
            "channel_id": "10",
            "amount": "1001"
          },
          {
            "channel_id": "20",
            "amount": "3001"
          },
          {
            "channel_id": "30",
