  ],
  "properties": [
    {
      "name": "canonical_identity",
      "statement": "Channel records and both weight tables are sorted by ascending stable channel ID before storage.",
      "status": "asserted"
    },
    {
      "name": "asset_conservation",
      "statement": "For each successful table, the apportioned amounts sum exactly to that asset's input total.",
      "status": "asserted"
    },
    {
      "name": "protected_first",
      "statement": "The configured protocol channel receives its ceiling before all other entries receive floors and deterministic residual units.",
      "status": "asserted"
    },
    {
      "name": "destination_isolation",
      "statement": "Each non-liquidity allocation is paid only to its immutable plan destination, inside the successful migration transaction.",
      "status": "required integration coverage"
    },
    {
      "name": "allocation_not_fee",
      "statement": "Protocol and external one-time allocations are paid at migration and never enter the recurring LP-fee routes.",
      "status": "required integration coverage"
    }
  ]
}
