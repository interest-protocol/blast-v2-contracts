{
  "schema_version": 1,
  "description": "Stepped-linear and exact checkpoint vesting boundaries.",
  "source_decisions": [
    "../decisions/0052-stepped-linear-vesting.md",
    "../decisions/0055-global-vesting-package-and-checkpoints.md"
  ],
  "units": {
    "amount": "atomic coin units",
    "time": "milliseconds",
    "rounding": "linear intermediate value rounds down and releases the remainder at the end; checkpoints release exact cumulative amounts"
  },
  "parameters": {
    "formula": "floor(total_amount * floor((timestamp_ms - start_ms) / period_ms) / periods)",
    "creation_rule": "start_ms >= current_onchain_timestamp_ms",
    "end_rule": "timestamp_ms >= start_ms + period_ms * periods vests total_amount",
    "checkpoint_rule": "the last checkpoint at or before timestamp_ms supplies the exact cumulative vested amount",
    "checkpoint_creation_rule": "1 to 256 strictly increasing timestamps and cumulative amounts; first timestamp >= current_onchain_timestamp_ms; final amount = funding"
  },
  "cases": [
    {
      "name": "cliff_and_four_periods_with_remainder",
      "kind": "boundary_table",
      "given": {
        "total_amount": "1001",
        "start_ms": "100",
        "cliff_ms": "200",
        "period_ms": "100",
        "periods": "4"
      },
      "expect": {
        "points": [
          { "timestamp_ms": "99", "vested": "0" },
          { "timestamp_ms": "100", "vested": "0" },
          { "timestamp_ms": "299", "vested": "0" },
          { "timestamp_ms": "300", "vested": "500" },
          { "timestamp_ms": "399", "vested": "500" },
          { "timestamp_ms": "400", "vested": "750" },
          { "timestamp_ms": "499", "vested": "750" },
          { "timestamp_ms": "500", "vested": "1001" }
        ]
      },
      "notes": "The cliff gates two accrued periods. The final atomic-unit remainder releases at the end."
    },
    {
      "name": "maximum_width_linear",
      "kind": "maximum_width",
      "given": {
        "total_amount": "18446744073709551615",
        "start_ms": "0",
        "cliff_ms": "0",
        "period_ms": "1",
        "periods": "18446744073709551615"
      },
      "expect": {
        "points": [
          { "timestamp_ms": "18446744073709551614", "vested": "18446744073709551614" },
          { "timestamp_ms": "18446744073709551615", "vested": "18446744073709551615" }
        ]
      },
      "notes": "Widened multiplication prevents intermediate overflow."
    },
    {
      "name": "three_irregular_checkpoints",
      "kind": "checkpoint_boundary_table",
      "given": {
        "total_amount": "1000",
        "checkpoints": [
          { "timestamp_ms": "100", "cumulative_amount": "100" },
          { "timestamp_ms": "250", "cumulative_amount": "400" },
          { "timestamp_ms": "700", "cumulative_amount": "1000" }
        ]
      },
      "expect": {
        "points": [
          { "timestamp_ms": "99", "vested": "0" },
          { "timestamp_ms": "100", "vested": "100" },
          { "timestamp_ms": "249", "vested": "100" },
          { "timestamp_ms": "250", "vested": "400" },
          { "timestamp_ms": "699", "vested": "400" },
          { "timestamp_ms": "700", "vested": "1000" }
        ]
      },
      "notes": "Checkpoint amounts are exact; no proportional rounding is applied."
    }
  ]
}
